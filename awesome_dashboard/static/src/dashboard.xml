<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <div class="d-inline-flex gap-1">
                    <button t-on-click="openCustomers" type="button" class="btn btn-primary" title="Customers">Customers</button>
                    <button t-on-click="openLeads" type="button" class="btn btn-primary ml-2" title="Leads">Leads</button>
                </div>
            </t>

            <div class="d-flex vertical-baseline flex-wrap">
                <DashboardItem>
                    <p class="text-center">Average amount of t-shirt by order this month</p>
                    <h2 style="color: green;text-align: center; font-size: 26px"><t t-out="data.average_quantity"/></h2>
                </DashboardItem>
                <DashboardItem>
                    <p class="text-center">Average time for an order to go from ‘new’ to ‘sent’ or ‘cancelled’</p>
                    <h2 style="color: green;text-align: center; font-size: 26px"><t t-out="data.average_time"/></h2>
                </DashboardItem>
                <DashboardItem>
                    <p class="text-center">Number of new orders this month</p>
                    <h2 style="color: green;text-align: center; font-size: 26px"><t t-out="data.nb_new_orders"/></h2>
                </DashboardItem>
                <DashboardItem>
                    <p class="text-center">Number of cancelled orders this month</p>
                    <h2 style="color: green;text-align: center; font-size: 26px"><t t-out="data.nb_cancelled_orders"/></h2>
                </DashboardItem>
                <DashboardItem>
                    <p class="text-center">Total amount of new orders this month</p>
                    <h2 style="color: green;text-align: center; font-size: 26px"><t t-out="data.total_amount"/></h2>
                </DashboardItem>
                <DashboardItem size="2">
                    <PieChart data="data.orders_by_size"/>
                </DashboardItem>
            </div>
        </Layout>
    </t>

</templates>
